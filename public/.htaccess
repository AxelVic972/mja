<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Performance : cache navigateur des ressources statiques ────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/gif           "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 year"
    ExpiresByType image/x-icon        "access plus 1 year"
    ExpiresByType text/css            "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript     "access plus 1 year"
    ExpiresByType font/woff2          "access plus 1 year"
    ExpiresByType font/woff           "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf            "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Ressources statiques versionnables : cache long + immutable
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # ─── En-têtes de sécurité ───────────────────────────────────────────────
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    # HSTS (HTTPS uniquement ; ignoré par les navigateurs en HTTP local)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # CSP : autorise le site + inline (nécessaire au design) + repli polices Google/CDN
    #
    # Stripe (paiement par carte de l'adhésion, via Stripe Elements) a besoin de
    # trois autorisations, sans lesquelles le formulaire affiche « le module de
    # paiement n'a pas pu se charger » :
    #   script-src  js.stripe.com    → la librairie Stripe.js
    #   frame-src   js.stripe.com    → les champs carte, servis en iframe
    #               hooks.stripe.com → l'authentification 3-D Secure
    #   connect-src api.stripe.com   → confirmation du paiement
    # img-src *.stripe.com couvre les logos de moyens de paiement.
    #   form-action checkout.stripe.com → page de paiement des dons
    #
    # form-action est aussi contrôlé sur la redirection qui suit l'envoi d'un
    # formulaire : le don part vers /don, puis le serveur redirige vers Stripe
    # Checkout. Sans ce domaine, le navigateur bloque l'envoi en signalant
    # l'adresse du formulaire, ce qui masque la vraie cause.
    #
    # Cloudflare Turnstile (anti-spam du formulaire de contact, activé par les
    # clés dans .env) charge un script et affiche son défi en iframe :
    #   script-src / frame-src / connect-src challenges.cloudflare.com
    # Ces domaines ne coûtent rien tant que le widget n'est pas activé.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https://*.stripe.com; connect-src 'self' https://api.stripe.com https://challenges.cloudflare.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://*.stripe.com; frame-ancestors 'self'"
</IfModule>

# ─── Compression ────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>
