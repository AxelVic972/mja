# Configuration de la pile Docker — à copier en .env.docker.
#
#   cp .env.docker.example .env.docker
#   docker compose run --rm --no-deps app php artisan key:generate --show
#
# .env.docker n'est pas suivi par git : il contient les mots de passe.

# ─── Application ──────────────────────────────────────────────────
APP_NAME="Madin'Jeunes Ambition"
APP_ENV=production
# Obligatoire. Générée une fois, puis jamais changée : une nouvelle clé rend
# illisibles toutes les sessions et tous les cookies signés existants.
APP_KEY=
APP_DEBUG=false
# Adresse publique réelle : elle sert à fabriquer les liens des courriels et
# les images de partage. Derrière un proxy HTTPS, mettre bien https://.
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Port publié sur l'hôte pour le site.
HTTP_PORT=8080

# Migrations jouées au démarrage du service web. À passer à false si le
# déploiement les lance dans une étape séparée.
RUN_MIGRATIONS=true
# Mise en cache de la configuration, des routes et des vues au démarrage.
CACHE_CONFIG=true

# ─── Base de données ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mja
DB_USERNAME=mja
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE
DB_ROOT_PASSWORD=CHANGER_AUSSI_CELUI_LA

# ─── Cache, sessions, file d'attente ──────────────────────────────
# Redis plutôt que la base : les sessions et le cache sont les écritures les
# plus fréquentes du site, les sortir de MySQL le soulage nettement.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ─── Courriel ─────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.mja-martinique.com
MAIL_PORT=587
MAIL_USERNAME=contact@mja-martinique.com
MAIL_PASSWORD=MOT_DE_PASSE_MAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@mja-martinique.com"
MAIL_FROM_NAME="Madin'Jeunes Ambition"

# ─── Paiement en ligne (adhésions) ────────────────────────────────
# Rien à mettre ici : les clés Stripe sont enregistrées dans la table
# `settings`, depuis Administration → Réglages, et seul un super-admin y a
# accès (voir app/Services/StripeService.php). Tant qu'elles sont absentes,
# la page d'adhésion propose simplement les autres moyens de règlement.

# ─── Anti-spam (Cloudflare Turnstile) ──────────────────────────────
# Créer un widget Turnstile pour le domaine public, puis renseigner les deux
# clés. La protection visuelle s'active seulement quand les deux sont présentes.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# MJA_ADHESION_MIN_FILL_SECONDS=3
